{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/prestasi",
      "destination": "/tentang#prestasi",
      "permanent": true
    },
    {
      "source": "/ipa/kelas-10",
      "destination": "/fisika/kelas-10",
      "permanent": true
    },
    {
      "source": "/ipa/kelas-11",
      "destination": "/fisika/kelas-11",
      "permanent": true
    },
    {
      "source": "/ipa/kelas-12",
      "destination": "/fisika/kelas-12",
      "permanent": true
    },
    {
      "source": "/ipa/kelas-10/:bab",
      "destination": "/fisika/kelas-10/:bab",
      "permanent": true
    },
    {
      "source": "/ipa/kelas-11/:bab",
      "destination": "/fisika/kelas-11/:bab",
      "permanent": true
    },
    {
      "source": "/ipa/kelas-12/:bab",
      "destination": "/fisika/kelas-12/:bab",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/llms(.*)\\.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    },
    {
      "source": "/paket-soal/(.*)\\.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    },
    {
      "source": "/(matematika|ipa|fisika|kimia|biologi|olimpiade)/(.*)\\.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    },
    {
      "source": "/datasets/(.*)\\.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/datasets/(.*)\\.jsonl",
      "headers": [
        { "key": "Content-Type", "value": "application/x-ndjson; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/ai-catalog.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(brand|papers|prestasi|people)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(sitemap\\.xml|rss\\.xml|robots\\.txt)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(app\\.html|akun|teacher|worksheet)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(teacher|quest|worksheet|solution|api)/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "<https://dutaedukasi.vercel.app/llms.txt>; rel=\"alternate\"; type=\"text/markdown\", <https://dutaedukasi.vercel.app/rss.xml>; rel=\"alternate\"; type=\"application/rss+xml\""
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), display-capture=(self), geolocation=()" }
      ]
    },
    {
      "source": "/kelas",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), display-capture=(self), geolocation=()" }
      ]
    },
    {
      "source": "/kelas/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), display-capture=(self), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/matematika",
      "destination": "/matematika.html"
    },
    {
      "source": "/matematika/:kelas/:bab",
      "destination": "/matematika/:kelas/:bab.html"
    },
    {
      "source": "/matematika/:kelas",
      "destination": "/matematika/:kelas.html"
    },
    {
      "source": "/ipa",
      "destination": "/ipa.html"
    },
    {
      "source": "/ipa/:kelas/:bab",
      "destination": "/ipa/:kelas/:bab.html"
    },
    {
      "source": "/ipa/:kelas",
      "destination": "/ipa/:kelas.html"
    },
    {
      "source": "/fisika",
      "destination": "/fisika.html"
    },
    {
      "source": "/fisika/:kelas/:bab",
      "destination": "/fisika/:kelas/:bab.html"
    },
    {
      "source": "/fisika/:kelas",
      "destination": "/fisika/:kelas.html"
    },
    {
      "source": "/kimia",
      "destination": "/kimia.html"
    },
    {
      "source": "/kimia/:kelas/:bab",
      "destination": "/kimia/:kelas/:bab.html"
    },
    {
      "source": "/kimia/:kelas",
      "destination": "/kimia/:kelas.html"
    },
    {
      "source": "/biologi",
      "destination": "/biologi.html"
    },
    {
      "source": "/biologi/:kelas/:bab",
      "destination": "/biologi/:kelas/:bab.html"
    },
    {
      "source": "/biologi/:kelas",
      "destination": "/biologi/:kelas.html"
    },
    {
      "source": "/olimpiade/:level/:bab",
      "destination": "/olimpiade/:level/:bab.html"
    },
    {
      "source": "/olimpiade/:level",
      "destination": "/olimpiade/:level.html"
    },
    {
      "source": "/olimpiade",
      "destination": "/olimpiade.html"
    },
    {
      "source": "/paket-soal/:subject/:slug",
      "destination": "/paket-soal/:subject/:slug.html"
    },
    {
      "source": "/paket-soal/:subject",
      "destination": "/paket-soal/:subject.html"
    },
    {
      "source": "/paket-soal",
      "destination": "/paket-soal.html"
    },
    {
      "source": "/tentang",
      "destination": "/tentang.html"
    },
    {
      "source": "/program",
      "destination": "/program.html"
    },
    {
      "source": "/pendiri",
      "destination": "/pendiri.html"
    },
    {
      "source": "/kontak",
      "destination": "/kontak.html"
    },
    {
      "source": "/daftar-isi",
      "destination": "/daftar-isi.html"
    },
    {
      "source": "/rumus",
      "destination": "/rumus.html"
    },
    {
      "source": "/tka/:paket",
      "destination": "/tka/:paket.html"
    },
    {
      "source": "/tka",
      "destination": "/tka.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
