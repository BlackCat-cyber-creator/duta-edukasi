{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/matematika/:kelas/:bab",
      "destination": "/matematika/:kelas/:bab.html"
    },
    {
      "source": "/matematika/:kelas",
      "destination": "/matematika/:kelas.html"
    },
    {
      "source": "/ipa/:kelas/:bab",
      "destination": "/ipa/:kelas/:bab.html"
    },
    {
      "source": "/ipa/:kelas",
      "destination": "/ipa/:kelas.html"
    },
    {
      "source": "/fisika/:kelas/:bab",
      "destination": "/fisika/:kelas/:bab.html"
    },
    {
      "source": "/fisika/:kelas",
      "destination": "/fisika/:kelas.html"
    },
    {
      "source": "/olimpiade/:level/:bab",
      "destination": "/olimpiade/:level/:bab.html"
    },
    {
      "source": "/olimpiade/:level",
      "destination": "/olimpiade/:level.html"
    },
    {
      "source": "/paket-soal/:subject/:slug",
      "destination": "/paket-soal/:subject/:slug.html"
    },
    {
      "source": "/paket-soal/:subject",
      "destination": "/paket-soal/:subject.html"
    },
    {
      "source": "/paket-soal",
      "destination": "/paket-soal.html"
    },
    {
      "source": "/tentang",
      "destination": "/tentang.html"
    },
    {
      "source": "/program",
      "destination": "/program.html"
    },
    {
      "source": "/pendiri",
      "destination": "/pendiri.html"
    },
    {
      "source": "/prestasi",
      "destination": "/prestasi.html"
    },
    {
      "source": "/kontak",
      "destination": "/kontak.html"
    },
    {
      "source": "/daftar-isi",
      "destination": "/daftar-isi.html"
    },
    {
      "source": "/rumus",
      "destination": "/rumus.html"
    },
    {
      "source": "/tka/:paket",
      "destination": "/tka/:paket.html"
    },
    {
      "source": "/tka",
      "destination": "/tka.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
